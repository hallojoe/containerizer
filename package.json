{
  "name": "containerizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Three.js particle container network",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node --check src/app.js && node --check scripts/build.mjs && node --check scripts/serve.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "three": "0.186.1" }
}
